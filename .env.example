SECRET_KEY=replace

MYSQL_ROOT_PASSWORD=replace
MYSQL_DATABASE=replace
MYSQL_USER=replace
MYSQL_PASSWORD=replace

DATABASE_URL=mysql+pymysql://proxyuser:<username>@db:3306/proxydb

ADMIN_API_KEY=a-very-secret-key

PROXY_HOST=0.0.0.0
PROXY_PORT=8888

# Development account: run the enroll -> proxy flow without Entra ID.
# Keep DEV_MODE=false anywhere real. DEV_PASSWORD must be >= 12 chars.
# The frontend/agent calls POST /dev/enroll with header X-Dev-Key: <DEV_PASSWORD>.
DEV_MODE=false
DEV_USERNAME=dev@localhost
DEV_PASSWORD=dev-password-change-me

# Browser origins allowed to call this API (the frontend). Empty = no CORS.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

ALLOWED_HOSTS=example.com,api.example.com

MAX_REQUEST_SIZE=10485760
